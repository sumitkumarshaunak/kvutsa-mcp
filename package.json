{
  "name": "getstatus-kvutsa-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Kvutsa MCP server: public, read-only tools over kvutsa-backend's HTTP API",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "NODE_ENV=local tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test vitest run --passWithNoTests",
    "inspector": "npx @modelcontextprotocol/inspector",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "pm2:logs": "pm2 logs kvutsa-mcp",
    "deploy": "npm run build && pm2 start ecosystem.config.cjs",
    "redeploy": "npm run build && pm2 reload kvutsa-mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
